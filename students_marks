import numpy as np
data_grades = np.array([

68, 72, 55, 80, 91, 64, 77, 83, 59, 70,
88, 62, 75, 95, 60, 100, 100, 100, 100, 100,
67, 73, 58, 81, 90, 65, 78, 84, 61, 71,
87, 63, 76, 94, 66, 100, 100, 100, 100, 100,
69, 74, 56, 82, 92, 64, 79, 85, 60, 72,
0, 0, 0, 0, 0, 65, 77, 83, 58, 70
])
A = np.array([68, 72, 55, 80, 91, 64, 77, 83, 59, 70, 88, 62, 75, 95, 60])

average = np.mean(data_grades)
print("Среднее значение оценок всех студентов:", average)

median = np.median(data_grades)
print("Медиана оценок всех студентов:", median)

standart_otklon = np.std(data_grades)
print("Стандартное отклонение оценок всех студентов:", standart_otklon)

dispersia = np.var(data_grades)
print("Дисперсия оценок всех студентов:", dispersia)

maximum = np.max(data_grades)
print("Максимальное значение:", maximum)

minimum = np.min(data_grades)
print("Минимальное значение:", minimum)

razmah = maximum - minimum
print("Размах оценок всех студентов:", razmah)

percentiles = np.percentile(data_grades, [25, 50, 75, 90, 99])
print("Перцентили 25, 50, 75, 90, 99:", percentiles)

q1 = np.percentile(data_grades, 25)
q3 = np.percentile(data_grades, 75)
print("Первый квартиль q1:", q1)
print("Третий квартиль q3:", q3)

iqr = q3 - q1
print("Межквартильный размах:", iqr)

lower_bound = q1 - 1.5 * iqr
upper_bound = q3 + 1.5 * iqr
outliers = data_grades[
    (data_grades < lower_bound) | (data_grades > upper_bound)
]
print("Нижняя граница:", lower_bound)
print("Верхняя граница:", upper_bound)
print("Выбросы:", outliers)

count_60_80 = np.sum((data_grades >= 60) & (data_grades <= 80))
print("Количество студентов c оценками от 60 до 80:", count_60_80)

matrix = np.array(A).reshape(3,5)
print("Матрица оценок:")
print(matrix)

print("Размерность матрицы:", matrix.shape)

print("Количество элементов в матрице:", matrix.size)

sum1 = matrix.sum(axis=0)
print("Сумма оценок по столбцам:", sum1)

sum2 = matrix.sum(axis=1)
print("Сумма оценок по строкам:", sum2)

print("Транспонированная матрица:")
print(matrix.T)

print("Среднее значение элементов матрицы:", np.mean(matrix))

print("Стандартное отклонение элементов матрицы:", np.std(matrix))

print("Дисперсия элементов матрицы:", np.var(matrix))

print("Первый квартиль Q1:", np.percentile(matrix, 25))

print("Второй квартиль Q2:", np.percentile(matrix, 50))

print("Третий квартиль Q3:", np.percentile(matrix, 75))



